{
  "hosting": [
    {
      "target": "docs",
      "public": "site",
      "redirects": [
        { "source": "/sssn", "destination": "https://sssn.one/", "type": 301 },
        { "source": "/sssn/**", "destination": "https://sssn.one/", "type": 301 },
        { "source": "/aaax", "destination": "https://aaax.one/", "type": 301 },
        { "source": "/aaax/**", "destination": "https://aaax.one/", "type": 301 }
      ],
      "rewrites": [
        { "source": "/hub", "run": { "serviceId": "lllm-hub", "region": "us-central1" } },
        { "source": "/hub/**", "run": { "serviceId": "lllm-hub", "region": "us-central1" } }
      ]
    }
  ]
}
