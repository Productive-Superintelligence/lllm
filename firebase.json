{
  "hosting": [
    {
      "target": "docs",
      "public": "site",
      "rewrites": [
        { "source": "/hub", "run": { "serviceId": "lllm-hub", "region": "us-central1" } },
        { "source": "/hub/**", "run": { "serviceId": "lllm-hub", "region": "us-central1" } }
      ]
    },
    {
      "target": "sssn",
      "public": "build/redirect",
      "redirects": [{ "source": "**", "destination": "https://lllm.one/sssn/", "type": 301 }]
    },
    {
      "target": "aaax",
      "public": "build/redirect",
      "redirects": [{ "source": "**", "destination": "https://lllm.one/aaax/", "type": 301 }]
    }
  ]
}
