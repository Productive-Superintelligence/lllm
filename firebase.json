{
  "hosting": [
    {
      "target": "docs",
      "public": "site",
      "redirects": [
        { "source": "/sssn", "destination": "https://sssn.one/", "type": 301 },
        { "source": "/sssn/**", "destination": "https://sssn.one/", "type": 301 },
        { "source": "/aaax", "destination": "https://aaax.one/", "type": 301 },
        { "source": "/aaax/**", "destination": "https://aaax.one/", "type": 301 },
        { "source": "/getting-started{,/**}", "destination": "/install/", "type": 301 },
        { "source": "/tutorials/01-quick-start{,/**}", "destination": "/", "type": 301 },
        { "source": "/tutorials/02-agents-and-dialogs{,/**}", "destination": "/agents/", "type": 301 },
        { "source": "/tutorials/03-prompts{,/**}", "destination": "/prompts/", "type": 301 },
        { "source": "/tutorials/04-tools{,/**}", "destination": "/tools/", "type": 301 },
        { "source": "/tutorials/05-native-tactics{,/**}", "destination": "/tactics/", "type": 301 },
        { "source": "/tutorials/06-packages-and-hub{,/**}", "destination": "/packages/", "type": 301 },
        { "source": "/tutorials/07-logging{,/**}", "destination": "/observability/", "type": 301 },
        { "source": "/tutorials/08-advanced-patterns{,/**}", "destination": "/examples/", "type": 301 },
        { "source": "/tutorials/09-serving{,/**}", "destination": "/serving/", "type": 301 },
        { "source": "/tutorials/10-pydantic-ai{,/**}", "destination": "/pydantic-ai/", "type": 301 },
        { "source": "/tutorials/11-channels{,/**}", "destination": "/#the-lllm-family", "type": 301 },
        { "source": "/tutorials{,/}", "destination": "/", "type": 301 },
        { "source": "/core/architecture{,/**}", "destination": "/concepts/", "type": 301 },
        { "source": "/core/agent{,/**}", "destination": "/agents/", "type": 301 },
        { "source": "/core/prompts{,/**}", "destination": "/prompts/", "type": 301 },
        { "source": "/core/dialog{,/**}", "destination": "/dialogs/", "type": 301 },
        { "source": "/core/tactic{,/**}", "destination": "/tactics/", "type": 301 },
        { "source": "/core/config{,/**}", "destination": "/configuration/", "type": 301 },
        { "source": "/core/invokers{,/**}", "destination": "/models/", "type": 301 },
        { "source": "/core/inference-hints{,/**}", "destination": "/inference-hints/", "type": 301 },
        { "source": "/core/proxy-and-sandbox{,/**}", "destination": "/proxies/", "type": 301 },
        { "source": "/core/logging{,/**}", "destination": "/observability/", "type": 301 },
        { "source": "/core/runtime{,/**}", "destination": "/configuration/", "type": 301 },
        { "source": "/protocol/tactic{,/**}", "destination": "/runtimes/", "type": 301 },
        { "source": "/protocol/runtimes{,/**}", "destination": "/runtimes/", "type": 301 },
        { "source": "/protocol/services{,/**}", "destination": "/serving/", "type": 301 },
        { "source": "/protocol/refs{,/**}", "destination": "/packages/", "type": 301 },
        { "source": "/packages/manifest{,/**}", "destination": "/packages/", "type": 301 },
        { "source": "/packages/discovery{,/**}", "destination": "/packages/", "type": 301 },
        { "source": "/packages/hub{,/**}", "destination": "/publishing/", "type": 301 },
        { "source": "/reference/cli{,/**}", "destination": "/api/cli/", "type": 301 },
        { "source": "/reference/service-api{,/**}", "destination": "/api/service-api/", "type": 301 },
        { "source": "/reference/hub-metadata{,/**}", "destination": "/api/hub-metadata/", "type": 301 }
      ],
      "rewrites": [
        { "source": "/hub", "run": { "serviceId": "lllm-hub", "region": "us-central1" } },
        { "source": "/hub/**", "run": { "serviceId": "lllm-hub", "region": "us-central1" } }
      ]
    }
  ]
}
